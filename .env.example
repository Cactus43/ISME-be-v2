# ─── Server (replace for your environment) ───
NODE_ENV=production
PORT=8081

# ─── Database (EXTERNAL MySQL on VPS/network - replace all) ───
DB_HOST=REPLACE_WITH_DB_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_DB_NAME
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ─── JWT (replace) ───
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS512
JWT_SESSION_MINUTES=1440

# ─── CORS (replace with allowed frontend origins, comma-separated) ───
CORS_ORIGINS=https://your-frontend.example.com

# ─── Data path ───
# For local non-Docker runs you can keep ./data.
# In Docker/Compose this is overridden to /data and mapped from host ./data.
DATA_PATH=./data

# ─── Logging ───
LOG_LEVEL=debug
