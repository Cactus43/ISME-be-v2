# ─── Server ───
NODE_ENV=development
PORT=8081

# ─── Database ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SteamLeaksV2
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ─── JWT ───
JWT_SECRET=
JWT_ALGORITHM=HS512
JWT_SESSION_MINUTES=1440

# ─── CORS ───
CORS_ORIGINS=http://localhost:3001

# ─── Data volume (photos, docs) ───
DATA_PATH=./data

# ─── Logging ───
LOG_LEVEL=debug
