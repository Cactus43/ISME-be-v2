# ─── Server ───────────────────────────────────────────────────────────────────
# NODE_ENV: runtime environment. Accepted values: development | production | test
NODE_ENV=production
# PORT: HTTP port the Express server listens on.
PORT=8081


# ─── Database ─────────────────────────────────────────────────────────────────
# DB_HOST: hostname or IP of the MySQL server. REQUIRED.
DB_HOST=REPLACE_WITH_DB_HOST
# DB_PORT: MySQL port. Optional — defaults to 3306.
DB_PORT=3306
# DB_NAME: name of the target database schema. REQUIRED.
DB_NAME=REPLACE_WITH_DB_NAME
# DB_USER: MySQL user with full access to DB_NAME. REQUIRED.
DB_USER=REPLACE_WITH_DB_USER
# DB_PASSWORD: password for DB_USER. REQUIRED.
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
# DB_POOL_MAX: maximum number of connections in the Sequelize pool. Optional — defaults to 10.
DB_POOL_MAX=10
# DB_POOL_MIN: minimum number of idle connections kept alive. Optional — defaults to 2.
DB_POOL_MIN=2


# ─── JWT ──────────────────────────────────────────────────────────────────────
# JWT_SECRET: secret used to sign tokens. Use a long random string (≥32 chars). REQUIRED.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# JWT_ALGORITHM: HMAC algorithm for JWT signing. Optional — defaults to HS512.
#   Accepted values: HS256 | HS384 | HS512
JWT_ALGORITHM=HS512
# JWT_SESSION_MINUTES: token lifetime in minutes. Optional — defaults to 1440 (24 h).
JWT_SESSION_MINUTES=1440


# ─── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGINS: comma-separated list of allowed frontend origins.
#   Optional — defaults to http://localhost:3001.
#   Example for multiple origins: https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://your-frontend.example.com


# ─── Cookies ──────────────────────────────────────────────────────────────────
# COOKIE_SECURE: set to true to mark auth cookies as Secure (HTTPS only).
#   Optional — defaults to false. Must be true in production behind HTTPS.
COOKIE_SECURE=true


# ─── Data path ────────────────────────────────────────────────────────────────
# DATA_PATH: directory where uploaded media files are stored.
#   Optional — defaults to ./data.
#   In Docker/Compose this is overridden to /data and mapped from the host ./data volume.
DATA_PATH=./data


# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: minimum log severity emitted by Pino.
#   Optional — defaults to info.
#   Accepted values: fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# ─── Features ─────────────────────────────────────────────────────────────────
# PRIORITY_TRACKING_LIMIT: maximum number of interventions shown in the
#   priority-tracking dashboard widget. Optional — defaults to 15.
PRIORITY_TRACKING_LIMIT=15
