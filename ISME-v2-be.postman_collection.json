    {
      "name": "🔍 Debug Token (DB Inspection)",
      "item": [
        {
          "name": "Decode Current Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This request doesn't actually call the server.",
                  "// It just decodes the stored token for inspection."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Decode the token stored in collection variables",
                  "const token = pm.collectionVariables.get('mobileToken');",
                  "",
                  "if (!token) {",
                  "    console.error('No token stored! Run Login Mobile first.');",
                  "} else {",
                  "    const parts = token.split('.');",
                  "    console.log('=== TOKEN ANALYSIS ===');",
                  "    console.log('Parts:', parts.length);",
                  "    console.log('Full length:', token.length);",
                  "    console.log('');",
                  "    ",
                  "    // Header",
                  "    const header = JSON.parse(atob(parts[0]));",
                  "    console.log('Header:', JSON.stringify(header));",
                  "    ",
                  "    // Payload",
                  "    const payload = JSON.parse(atob(parts[1]));",
                  "    console.log('Payload:', JSON.stringify(payload, null, 2));",
                  "    console.log('');",
                  "    console.log('userId:', payload.userId);",
                  "    console.log('username:', payload.username);",
                  "    console.log('deviceId:', payload.deviceId);",
                  "    console.log('exp:', new Date(payload.exp * 1000).toISOString());",
                  "    console.log('expired?:', Date.now() > payload.exp * 1000);",
                  "    console.log('');",
                  "    ",
                  "    // Signature (this is what the backend uses for DB lookup)",
                  "    console.log('Signature (full):', parts[2]);",
                  "    console.log('Signature length:', parts[2].length);",
                  "    console.log('');",
                  "    console.log('💡 Search this signature in access_tokens.signature column.');",
                  "    console.log('   SELECT * FROM access_tokens WHERE signature = \\'' + parts[2] + '\\';');",
                  "}",
                  "",
                  "// The actual response doesn't matter — this is a diagnostic request",
                  "pm.test('Token decoded (see console)', function () {",
                  "    pm.expect(token).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Non è una vera request — usa il test script per decodificare e analizzare il token salvato.\n\nControlla la console Postman per:\n- JWT header/payload decodificato\n- Signature (usata per il lookup in access_tokens)\n- Query SQL per cercare il token nel DB\n- Se il token è scaduto"
          },
          "response": []
        },
        {
          "name": "Login + Immediate Verify (Race Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "if (res.data && res.data.Token) {",
                  "    const token = res.data.Token;",
                  "    pm.collectionVariables.set('mobileToken', token);",
                  "    ",
                  "    const parts = token.split('.');",
                  "    console.log('Login OK. Token signature:', parts[2].substring(0, 20) + '...');",
                  "    ",
                  "    // Immediately verify",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/auth/mobile/verify',",
                  "        method: 'GET',",
                  "        header: {",
                  "            'Authorization': 'Bearer ' + token",
                  "        }",
                  "    }, function (err, verifyRes) {",
                  "        if (err) {",
                  "            console.error('❌ Verify request failed:', err);",
                  "            return;",
                  "        }",
                  "        const verifyBody = verifyRes.json();",
                  "        console.log('Verify status:', verifyRes.code);",
                  "        console.log('Verify body:', JSON.stringify(verifyBody));",
                  "        ",
                  "        if (verifyRes.code === 401) {",
                  "            console.error('❌❌❌ TOKEN IS INVALID IMMEDIATELY AFTER LOGIN!');",
                  "            console.error('Backend Error:', verifyBody.Error);",
                  "            console.error('This confirms the bug is in the BACKEND, not in the Electron app.');",
                  "            console.error('The token returned by login() cannot pass the Authenticate middleware.');",
                  "        } else if (verifyRes.code === 200 && verifyBody.data?.Valid) {",
                  "            console.log('✅ Token is valid immediately after login. The auth flow works correctly.');",
                  "            console.log('If the Electron app still gets 401, the issue is in token storage/retrieval (encrypt/decrypt).');",
                  "        }",
                  "        ",
                  "        // Also test sync endpoint",
                  "        pm.sendRequest({",
                  "            url: pm.collectionVariables.get('baseUrl') + '/api/interventions/mobile/sync',",
                  "            method: 'GET',",
                  "            header: {",
                  "                'Authorization': 'Bearer ' + token",
                  "            }",
                  "        }, function (err2, syncRes) {",
                  "            if (err2) {",
                  "                console.error('❌ Sync request failed:', err2);",
                  "                return;",
                  "            }",
                  "            console.log('Sync GET status:', syncRes.code);",
                  "            if (syncRes.code === 401) {",
                  "                const syncBody = syncRes.json();",
                  "                console.error('❌ Sync returns 401! Error:', syncBody.Error);",
                  "            } else {",
                  "                const syncBody = syncRes.json();",
                  "                console.log('✅ Sync GET OK — received', (syncBody.data || []).length, 'interventions');",
                  "            }",
                  "        });",
                  "    });",
                  "} else {",
                  "    console.error('Login failed:', JSON.stringify(res));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"operatore1\",\n    \"password\": \"password123\",\n    \"deviceUuid\": \"postman-debug-device\",\n    \"deviceName\": \"Postman Debug\",\n    \"platform\": \"other\",\n    \"appVersion\": \"2.0.0-debug\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/mobile/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mobile", "login"]
            },
            "description": "**TEST CRITICO:**\n\n1. Fa login\n2. IMMEDIATAMENTE fa verify con lo stesso token\n3. IMMEDIATAMENTE fa sync GET con lo stesso token\n\nSe verify o sync falliscono con 401, **il bug è nel backend** — il token appena emesso non è valido.\n\nSe tutto funziona qui ma l'Electron app fallisce, il bug è nella encrypt/decrypt del token in SessionManager."
          },
          "response": []
        }
      ]
    },
