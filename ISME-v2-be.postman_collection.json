    {
      "name": "🔐 Auth - Mobile (Electron/Tablet)",
      "item": [
        {
          "name": "1. Login Mobile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(res.data).to.have.property('Token');",
                  "});",
                  "",
                  "if (res.data && res.data.Token) {",
                  "    pm.collectionVariables.set('mobileToken', res.data.Token);",
                  "    ",
                  "    // Decode JWT and show payload",
                  "    const parts = res.data.Token.split('.');",
                  "    const payload = JSON.parse(atob(parts[1]));",
                  "    console.log('JWT Payload:', JSON.stringify(payload, null, 2));",
                  "    console.log('Token signature (for DB lookup):', parts[2]);",
                  "    console.log('Token signature length:', parts[2].length);",
                  "    console.log('Expires at:', new Date(payload.exp * 1000).toISOString());",
                  "    console.log('User ID:', payload.userId);",
                  "    console.log('Full token length:', res.data.Token.length);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"operatore1\",\n    \"password\": \"password123\",\n    \"deviceUuid\": \"postman-debug-device\",\n    \"deviceName\": \"Postman Debug\",\n    \"platform\": \"other\",\n    \"appVersion\": \"2.0.0-debug\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/mobile/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mobile", "login"]
            },
            "description": "Login mobile — salva automaticamente il token nella variabile `mobileToken`.\n\n⚠️ **Cambia username e password con credenziali valide!**\n\nIl test script:\n- Salva il token per le request successive\n- Decodifica il JWT payload e lo stampa nella console\n- Mostra la signature (usata per DB lookup)"
          },
          "response": []
        },
        {
          "name": "2. Verify Mobile Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Verify returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Session is valid', function () {",
                  "    pm.expect(res.data).to.have.property('Valid', true);",
                  "});",
                  "",
                  "if (pm.response.code === 401) {",
                  "    console.error('❌ 401! Backend Error:', res.Error || JSON.stringify(res));",
                  "    console.log('Token used:', pm.collectionVariables.get('mobileToken').substring(0, 50) + '...');",
                  "    ",
                  "    // Decode to check expiry",
                  "    const token = pm.collectionVariables.get('mobileToken');",
                  "    if (token) {",
                  "        const parts = token.split('.');",
                  "        const payload = JSON.parse(atob(parts[1]));",
                  "        console.log('Token exp:', new Date(payload.exp * 1000).toISOString());",
                  "        console.log('Now:', new Date().toISOString());",
                  "        console.log('Signature:', parts[2]);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobileToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/mobile/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mobile", "verify"]
            },
            "description": "Verifica che il token mobile sia ancora valido.\n\n**Se questo ritorna 401 subito dopo il login, il bug è nel backend.**\n\nControlla nella console Postman:\n- L'errore esatto del backend\n- La signature del token\n- La scadenza del JWT"
          },
          "response": []
        },
        {
          "name": "3. Logout Mobile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout success', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('Token revoked on server. Next verify should return 401.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobileToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/mobile/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mobile", "logout"]
            },
            "description": "Revoca il token mobile sul server.\n\n⚠️ Dopo il logout, il token non sarà più valido — dovrai rifare il login."
          },
          "response": []
        },
        {
          "name": "4. Verify AFTER Logout (should 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 401 after logout', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "console.log('Expected 401, got:', pm.response.code, '| Error:', res.Error || 'none');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mobileToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/mobile/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mobile", "verify"]
            },
            "description": "Dopo il logout, verifica che il token sia stato effettivamente revocato.\nDeve ritornare 401."
          },
          "response": []
        }
      ]
    },
