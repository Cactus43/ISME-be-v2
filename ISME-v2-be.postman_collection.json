    {
      "key": "baseUrl",
      "value": "http://76.13.155.31:8082",
      "type": "string"
    },
    {
      "key": "mobileToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "interventionId",
      "value": "1",
      "type": "string"
    },
