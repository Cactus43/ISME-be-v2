# v1 -> v2 migration env
# Copy this file to migration/v1tov2/.env and fill values.
# This file is loaded automatically by migration/v1tov2/MigrateV1ToV2.ts.
# Values here override root .env only for the migration run.

# --- SOURCE DB (v1) ---
MIGRATION_SOURCE_DB_HOST=127.0.0.1
MIGRATION_SOURCE_DB_PORT=3306
MIGRATION_SOURCE_DB_NAME=SteamLeaks
MIGRATION_SOURCE_DB_USER=root
MIGRATION_SOURCE_DB_PASSWORD=secret

# --- TARGET DB (v2) ---
# Optional: if omitted, script uses DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD from root .env
MIGRATION_TARGET_DB_HOST=127.0.0.1
MIGRATION_TARGET_DB_PORT=3306
MIGRATION_TARGET_DB_NAME=SteamLeaksV2
MIGRATION_TARGET_DB_USER=root
MIGRATION_TARGET_DB_PASSWORD=secret

# --- SAFETY FLAGS ---
# true: run full migration then rollback transaction
MIGRATION_DRY_RUN=true
# true: truncate target tables before import
MIGRATION_TRUNCATE_TARGET=false
# true: allow import into non-empty target DB
MIGRATION_ALLOW_NON_EMPTY_DESTINATION=false

# --- MEDIA IMPORT ---
MIGRATION_INCLUDE_MEDIA=true
# Keep URL-based media import from v1 DB fields img_url / after_img_url
MIGRATION_MEDIA_FROM_DB_URLS=true

# Scan folders for real files with naming:
#   <intervention_id>_photo_before.*  OR  <tag>.jpg (v1 convention)
MIGRATION_MEDIA_SCAN_ROOT=./data
MIGRATION_MEDIA_BEFORE_DIR=photo_before
MIGRATION_MEDIA_AFTER_DIR=photo_after
# Target backend data/ folder — photos are copied here as {id}_photo_before.jpg
MIGRATION_MEDIA_TARGET_ROOT=./data

# --- CLEANUP TARGET DB ---
# Safety confirmation required by cleanup script.
# Set to YES only when you intentionally want to truncate migration target tables.
MIGRATION_CLEAN_CONFIRM=
